<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>
    <PackageId>OpenExit</PackageId>
    <Version>0.1.0</Version>
    <AssemblyName>OpenExit</AssemblyName>
    <RootNamespace>OpenExit</RootNamespace>
    <Description>.NET SDK for OpenExit and PASP — the Portable Application State Protocol.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType></RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <EmbeddedResource Include="Schemas\*.json">
      <LogicalName>OpenExit.Schemas.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenExit.Tests" />
  </ItemGroup>
</Project>
